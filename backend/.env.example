# ═══════════════════════════════════════════════════════
#  AMC My Parking Turn — Variables de entorno
#  Copiar este archivo como .env y ajustar los valores
# ═══════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos PostgreSQL ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mpt_parking
DB_USER=mpt_app
DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# ── Superadmin DB (solo para migraciones y seed) ────────
DB_SUPERUSER=postgres
DB_SUPERPASSWORD=CAMBIAR_EN_PRODUCCION

# ── JWT ──────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_A_UN_STRING_ALEATORIO_DE_64_BYTES_EN_PRODUCCION
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────
# En producción, especificar el dominio exacto del frontend
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Bcrypt ───────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── SUPERADMIN inicial (se usa en npm run seed) ──────────
# El seed crea el primer parqueadero y el usuario SUPERADMIN
SEED_PARQUEADERO_NOMBRE=My Parking Turn - Desarrollo
SEED_PARQUEADERO_CODIGO=PARK001
SEED_PARQUEADERO_NIT=1110591592
SEED_ADMIN_DOCUMENTO=1110591592
SEED_ADMIN_NOMBRE=USUARIO DESARROLLADOR
SEED_ADMIN_EMAIL=andresitomao@gmail.com
# Defina esta variable solo en su archivo .env local. No publique este archivo.
# SEED_ADMIN_PASSWORD=su_clave_segura
