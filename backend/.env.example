# Entorno
NODE_ENV=production
PORT=3000
# Solo se necesita si el frontend usa otro dominio.
# Obligatorio en producción, incluso si frontend y API comparten dominio.
CORS_ORIGIN=https://app.ejemplo.com

# PostgreSQL administrado (URL entregada por el host)
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE_DE_DATOS
DB_SSL=true
# Mantener true; si el proveedor usa CA propia, instálala en el VPS.
DB_SSL_REJECT_UNAUTHORIZED=true

# Alternativa para PostgreSQL propio (no usar junto a DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mpt_parking
# DB_USER=mpt_app
# DB_PASSWORD=CAMBIAR

JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=8h

# Para migrate y seed. DB_SUPER_URL solo si es diferente de DATABASE_URL.
# DB_SUPER_URL=postgresql://ADMIN:CONTRASENA@HOST:5432/BASE_DE_DATOS
SEED_ADMIN_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA
SEED_ADMIN_DOCUMENTO=1110591592
SEED_ADMIN_NOMBRE=USUARIO DESARROLLADOR
SEED_ADMIN_EMAIL=andresitomao@gmail.com
SEED_PARQUEADERO_CODIGO=PARK001
SEED_PARQUEADERO_NOMBRE=My Parking Turn
